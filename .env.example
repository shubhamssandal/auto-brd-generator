# Auto-BRD Generator — environment variable NAMES only.
#
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored and
# its values are never printed, logged, or displayed in the app.
#
#   cp .env.example .env
#
# Only GEMINI_API_KEY is required. Manual Paste and TXT Upload work with nothing
# else set; each cloud provider simply reports "Provider Not Configured" until
# its variables are present.

# --- Required: BRD generation ---------------------------------------------
# Google AI Studio API key used for Gemini BRD generation.
GEMINI_API_KEY=

# --- Optional: Google Meet transcripts -----------------------------------
# From an existing OAuth 2.0 "Web application" client in your Google Cloud
# project. The client's Authorized redirect URI must match APP_REDIRECT_URI
# exactly. Requires the Google Meet API and Google Drive API to be enabled.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=

# --- Optional: Microsoft Teams transcripts -------------------------------
# From an existing Microsoft Entra ID app registration. The registration needs a
# Web redirect URI matching APP_REDIRECT_URI and admin consent for the delegated
# Graph permissions listed in the README.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# --- Optional: Jira Cloud integration ------------------------------------
# From an OAuth 2.0 (3LO) app in the Atlassian Developer console. The app's
# callback URL must match APP_REDIRECT_URI. Jira is optional: transcript
# ingestion and BRD generation work without these.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# --- Optional: shared OAuth settings -------------------------------------
# Redirect URI registered with each integration. Defaults to
# http://localhost:8501 when unset.
APP_REDIRECT_URI=

# Optional signing secret for OAuth state/PKCE values. When unset, a random key
# is generated per process, which means any in-flight sign-in is invalidated by
# an app restart. Set it to keep sign-ins valid across restarts.
OAUTH_STATE_SECRET=

# Optional: set to "python" if protobuf raises a C-extension error on your
# platform.
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=
